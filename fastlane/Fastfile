default_platform(:android)

private_lane :perform_ios_upload do
  setup_ci
  api_key = app_store_connect_api_key(
    key_id: ENV['ASC_KEY_ID'],
    issuer_id: ENV['ASC_ISSUER_ID'],
    key_content: ENV['ASC_KEY_CONTENT'],
    is_key_content_base64: true
  )
  match(
    type: 'appstore',
    readonly: true,
    api_key: api_key
  )
  current_build = latest_testflight_build_number(
    api_key: api_key,
    app_identifier: 'gizz.tapes.GizzTapes'
  )
  increment_version_number(
    version_number: read_gradle_properties['gizz.tapes.iosVersion'],
    xcodeproj: 'iosApp/iosApp.xcodeproj'
  )
  increment_build_number(
    build_number: current_build + 1,
    xcodeproj: 'iosApp/iosApp.xcodeproj'
  )
  update_code_signing_settings(
    use_automatic_signing: false,
    path: 'iosApp/iosApp.xcodeproj',
    team_id: 'QHJAD8Z2WL',
    bundle_identifier: 'gizz.tapes.GizzTapes',
    code_sign_identity: 'Apple Distribution',
    profile_name: 'match AppStore gizz.tapes.GizzTapes'
  )
  build_app(
    project: 'iosApp/iosApp.xcodeproj',
    scheme: 'iosApp',
    configuration: 'Release',
    export_method: 'app-store'
  )
  upload_to_app_store(
    api_key: api_key,
    submit_for_review: true,
    automatic_release: false
  )
end

private_lane :perform_version_bump do
  properties = read_gradle_properties
  ios_major, ios_minor = properties['gizz.tapes.iosVersion'].split('.').map(&:to_i)

  content = File.read('../CHANGELOG.adoc')

  next_release_name = prompt(
    text: "Enter the name of the next release:"
  )

  updated_content = content.sub(/^== .*/) do |match|
    "#{match} #{Date.today.iso8601}"
  end
  updated_content = updated_content.sub(/^= .*/) do |match|
    "#{match}\n\n== #{next_release_name}"
  end

  File.write('../CHANGELOG.adoc', updated_content)

  properties['gizz.tapes.versionName'] = next_release_name.split.join("")
  properties['gizz.tapes.iosVersion'] = "#{ios_major}.#{ios_minor + 1}"
  update_gradle_properties(properties)

  git_commit(
    path: [File.expand_path('../gradle.properties'), File.expand_path('../CHANGELOG.adoc')],
    message: 'Version Bump'
  )
  push_to_git_remote()
end

def read_gradle_properties
  properties = {}
  File.readlines('../gradle.properties').each do |line|
    next if line.strip.empty? || line.strip.start_with?('#')
    key, value = line.strip.split('=', 2)
    properties[key] = value.strip if key && value
  end
  properties
end

def update_gradle_properties(properties)
  gradle_properties_lines = File.readlines('../gradle.properties')

  gradle_properties_lines = gradle_properties_lines.map do |line|
    if line.strip.start_with?("#") || line.strip.empty?
      line
    else
      key, value = line.strip.split("=", 2)
      if properties.key?(key)
        "#{key}=#{properties[key]}\n"
      else
        line
      end
    end
  end

  File.write('../gradle.properties', gradle_properties_lines.join)
end

platform :ios do
  desc 'Build and submit to App Store for review'
  lane :release do
    perform_ios_upload()
  end

  desc 'Build and upload to TestFlight'
  lane :beta do
    setup_ci
    api_key = app_store_connect_api_key(
      key_id: ENV['ASC_KEY_ID'],
      issuer_id: ENV['ASC_ISSUER_ID'],
      key_content: ENV['ASC_KEY_CONTENT'],
      is_key_content_base64: true
    )
    match(
      type: 'appstore',
      readonly: true,
      api_key: api_key
    )
    current_build = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: 'gizz.tapes.GizzTapes'
    )
    increment_version_number(
      version_number: read_gradle_properties['gizz.tapes.iosVersion'],
      xcodeproj: 'iosApp/iosApp.xcodeproj'
    )
    increment_build_number(
      build_number: current_build + 1,
      xcodeproj: 'iosApp/iosApp.xcodeproj'
    )
    update_code_signing_settings(
      use_automatic_signing: false,
      path: 'iosApp/iosApp.xcodeproj',
      team_id: 'QHJAD8Z2WL',
      bundle_identifier: 'gizz.tapes.GizzTapes',
      code_sign_identity: 'Apple Distribution',
      profile_name: 'match AppStore gizz.tapes.GizzTapes'
    )
    build_app(
      project: 'iosApp/iosApp.xcodeproj',
      scheme: 'iosApp',
      configuration: 'Release',
      export_method: 'app-store'
    )
    upload_to_testflight(
      api_key: api_key,
      distribute_external: true,
      groups: ["external testers"],
      notify_external_testers: true,
      changelog: ENV["CHANGELOG"]
    )
  end
end

platform :android do
  desc 'Publish a new build to Play Store beta'
  lane :beta do
    gradle(
      task: 'bundle',
      flavor: 'full',
      build_type: 'Release'
    )
    upload_to_play_store(
      track: 'beta',
      skip_upload_apk: true,
      aab: lane_context[:GRADLE_AAB_OUTPUT_PATH]
    )
  end

  desc 'Upload release artifacts to Play Store production and create GitHub release (CI only)'
  lane :ci_release do
    properties = read_gradle_properties
    version_name = properties['gizz.tapes.versionName']

    content = File.read('../CHANGELOG.adoc')
    description = content.split(/^== .*/)[1].strip

    full_aab = Dir.glob('../androidApp/build/outputs/bundle/fullRelease/*.aab').first
    UI.user_error!('Could not find full release AAB') unless full_aab

    upload_to_play_store(
      track: 'production',
      aab: full_aab,
      skip_upload_apk: true,
      skip_upload_changelogs: true
    )

    apk_files = Dir.glob('../androidApp/build/outputs/apk/**/*release*.apk')
    aab_files = Dir.glob('../androidApp/build/outputs/bundle/**/*release*.aab')
    asc_files = Dir.glob('../androidApp/build/outputs/**/*.asc')
    upload_assets = apk_files + aab_files + asc_files

    if upload_assets.empty?
      UI.error('No files found to upload to GitHub release!')
    else
      UI.success("Uploading: #{upload_assets.join(', ')}")
    end

    set_github_release(
      repository_name: 'Ghost-Applications/gizz-tapes',
      api_token: ENV['GITHUB_TOKEN'],
      name: version_name,
      tag_name: version_name,
      description: description,
      upload_assets: upload_assets
    )
  end

  desc 'Tag the current version and trigger CI release, then bump version'
  lane :release do
    ensure_git_branch(branch: 'main')
    ensure_git_status_clean
    version_name = read_gradle_properties['gizz.tapes.versionName']
    add_git_tag(tag: version_name)
    push_git_tags
    UI.success("Tag '#{version_name}' pushed — CI will publish to both stores.")
    perform_version_bump
  end
end
