import kotlin.UShort;
import kotlinx.datetime.LocalDate;

CREATE TABLE shows(
  id TEXT NOT NULL PRIMARY KEY,
  sortOrder INTEGER AS UShort NOT NULL,
  date TEXT AS LocalDate NOT NULL,
  posterUrl TEXT,
  notes TEXT,
  title TEXT,
  permalink TEXT NOT NULL,
  showData TEXT
);

insertShow:
INSERT OR IGNORE INTO shows VALUES ?;

selectShow:
SELECT * FROM shows WHERE id = ?;

selectDownloadedShows:
SELECT DISTINCT shows.* FROM shows
JOIN recordings ON recordings.showId = shows.id
JOIN files ON files.recordingId = recordings.id
ORDER BY shows.date DESC;
